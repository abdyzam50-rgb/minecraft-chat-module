{
  "$schema": "https://workers.cloudflare.com/schema.json",
  "name": "minecraft-chat-gemini",
  "main": "src/index.js",
  "compatibility_date": "2026-09-14",
  // The workflow copies web/ to ./public before deploying, so the page and the
  // API share one origin. Requests that do not match a file fall through to
  // src/index.js, which is what serves /api/reply and /health.
  "assets": { "directory": "./public" },
  // LLM_PROVIDER names what to try FIRST, not the only thing to try. Whatever
  // else has a key is tried after it, because a quota is a property of one
  // account on one day, not of the request: a free Gemini key stops answering
  // after twenty, and OpenRouter's free pools are saturated as often as not.
  // Neither is dependable alone; together they usually are.
  //
  // OPENAI_MODEL is a list, tried in order.
  "vars": {
    "GEMINI_MODEL": "gemini-3.6-flash",
    "LLM_PROVIDER": "gemini",
    "OPENAI_BASE_URL": "https://openrouter.ai/api/v1",
    "OPENAI_MODEL": "google/gemma-4-26b-a4b-it:free, google/gemma-4-31b-it:free, nex-agi/nex-n2.5-mini:free, inclusionai/ling-3.0-flash-vl:free, liquid/lfm-2.5-2.6b:free"
  }
}
