{
  "$schema": "https://workers.cloudflare.com/schema.json",
  "name": "minecraft-chat-gemini",
  "main": "src/index.js",
  "compatibility_date": "2026-09-14",
  // The workflow copies web/ to ./public before deploying, so the page and the
  // API share one origin. Requests that do not match a file fall through to
  // src/index.js, which is what serves /api/reply and /health.
  "assets": { "directory": "./public" },
  // LLM_PROVIDER picks the upstream: "openai" is the wire format, not the
  // vendor, and points at OPENAI_BASE_URL with the TOKENROUTER_API_KEY secret.
  //
  // On "gemini" while the TokenRouter key is sorted out: api.tokenrouter.com
  // answered "401: Invalid token", which is the key value, not the wiring —
  // the gateway read our Bearer header and refused it. Note there are two
  // unrelated services with this name: api.tokenrouter.com (the one with
  // z-ai/glm-5.3-free) and api.tokenrouter.io (keys prefixed tr_). A key from
  // one is an invalid token at the other.
  "vars": {
    "GEMINI_MODEL": "gemini-3.6-flash",
    "LLM_PROVIDER": "gemini",
    "OPENAI_BASE_URL": "https://api.tokenrouter.com/v1",
    "OPENAI_MODEL": "z-ai/glm-5.3-free"
  }
}
